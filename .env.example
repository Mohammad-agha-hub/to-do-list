# Password for the single user
APP_PASSWORD=change-me
# Random string used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=replace-with-random-hex
# Optional: SQLite file location (default ./data/momentum.db)
# DATABASE_PATH=./data/momentum.db
# Optional: allow the session cookie over plain http in production
# (only for testing on a LAN IP like http://192.168.1.5:3000; use HTTPS for real use)
# INSECURE_COOKIE=1
